{
  "name": "silt",
  "productName": "Silt",
  "version": "0.1.2",
  "description": "Silt — storage, explained. A free, open-source Mac app that shows where your disk space went (including the hidden System Data) and cleans it up safely.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Silt contributors",
  "homepage": "https://github.com/thestealthgoat/Mac-cleaning",
  "repository": {
    "type": "git",
    "url": "https://github.com/thestealthgoat/Mac-cleaning.git"
  },
  "bugs": {
    "url": "https://github.com/thestealthgoat/Mac-cleaning/issues"
  },
  "keywords": [
    "macos",
    "disk",
    "storage",
    "cleaner",
    "system-data",
    "electron"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
    "lint": "node scripts/check-syntax.js",
    "dist": "electron-builder --mac --publish never",
    "dist:dir": "electron-builder --mac dir --publish never",
    "snap": "SILT_SNAP_DIR=docs/screenshots electron .",
    "art": "electron scripts/make-art.js",
    "dist:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never -c.mac.notarize=false"
  },
  "build": {
    "appId": "io.github.thestealthgoat.silt",
    "productName": "Silt",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "!src/main/dev-snapshots.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2026 Silt contributors. MIT License.",
        "LSApplicationCategoryType": "public.app-category.utilities",
        "NSAppleEventsUsageDescription": "Silt uses Terminal to run the cleanup commands you choose, and Finder to empty the Trash when you ask it to."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Install Silt",
      "background": "build/background.png",
      "icon": "build/icon.icns",
      "iconSize": 112,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 172,
          "y": 205,
          "type": "file"
        },
        {
          "x": 428,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "Silt-${version}-${arch}.dmg"
    },
    "copyright": "Copyright © 2026 Silt contributors",
    "artifactName": "Silt-${version}-${arch}-mac.${ext}"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
